{
  "name": "ecommerce Codespace",
  "dockerComposeFile": ["docker-compose.codespace.yml"],
  "service": "codespace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "postStartCommand": "echo 'Start services with: docker compose -f docker-compose.codespace.yml up -d'",
  "forwardPorts": [3000, 3001, 4000, 9001, 8025, 5432, 6379],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "extensions": [
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "ms-azuretools.vscode-docker"
  ],
  "remoteUser": "vscode"
}
