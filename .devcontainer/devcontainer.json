{
  "name": "ecommerce Codespace",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.codespace.yml"],
  "service": "codespace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "postStartCommand": "pnpm local:up --silent || echo 'pnpm local:up failed; start services manually in a Codespace terminal'",
  "forwardPorts": [3000, 3001, 4000, 9001, 8025, 5432, 6379],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "extensions": [
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "ms-azuretools.vscode-docker"
  ],
  "remoteUser": "vscode"
}
