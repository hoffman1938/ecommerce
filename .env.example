# ==========================================================================
# Outlet Marketplace — environment template
#
# Copy to `.env` for Docker Compose usage:   cp .env.example .env
# Values below are safe local-development defaults. Never commit real secrets.
#
# Hostnames like `postgres`, `redis`, `minio`, `mailpit` resolve inside the
# Docker Compose network. When running apps directly on the host (without
# Docker), use `.env.local.example` instead (localhost hostnames).
# ==========================================================================

NODE_ENV=development

# --- Public URLs -----------------------------------------------------------
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# Browser-exposed variables (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:9000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://outlet:outlet@postgres:5432/outlet

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO locally, S3/R2 in production) -------------------
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=outlet-local
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally) -----------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Outlet Marketplace <no-reply@outlet.local>"

# --- Payments --------------------------------------------------------------
# mock | stripe
PAYMENT_PROVIDER=mock
# Shared secret used to sign mock webhook payloads locally (any random string)
MOCK_PAYMENT_WEBHOOK_SECRET=local-mock-webhook-secret
# Only needed when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Owner account ---------------------------------------------------------
# Optional real Super Admin, created by `pnpm db:seed` in addition to the
# admin@example.local placeholder. Set both to enable it; leave blank to skip.
#
# Keep these in `.env` (gitignored) — never in `.env.example` or source. The
# seed re-hashes this password on every run, so changing it here and re-seeding
# is a genuine rotation.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_FIRST_NAME=
SEED_SUPERADMIN_LAST_NAME=

# --- Auth / security -------------------------------------------------------
# Random string used to hash session tokens; change for anything non-local.
SESSION_SECRET=local-dev-session-secret-change-me
SESSION_COOKIE_NAME=outlet_session
CART_COOKIE_NAME=outlet_cart
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated list of origins allowed by CORS
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# none | turnstile
CAPTCHA_PROVIDER=none
TURNSTILE_SECRET_KEY=

# --- Business settings -----------------------------------------------------
RESERVATION_DURATION_MINUTES=20
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=en

# --- Worker ----------------------------------------------------------------
RESERVATION_SWEEP_INTERVAL_SECONDS=30
CAMPAIGN_SWEEP_INTERVAL_SECONDS=60

# --- API server ------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Set to true when behind a reverse proxy (Cloudflare, load balancer)
TRUST_PROXY=false

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ==========================================================================
# Cloudflare demo stack (apps/edge — Workers + D1 + R2)
#
# Everything above configures the local Docker stack. This section configures
# the deployed demo, and the split matters: the values here are set with
# `wrangler secret put`, in the Cloudflare dashboard, or as build variables in
# the Pages project — NOT by copying this file to a server.
#
# Names are public; values are not. Nothing below should ever be filled in
# inside a committed file.
# ==========================================================================

# --- Worker secrets (wrangler secret put NAME) -----------------------------
# Keys the HMAC that hashes session tokens before they are stored. Required:
# the Worker refuses to start outside development without it.
#   openssl rand -base64 32
# SESSION_SECRET=

# Passwords for the seeded demo accounts. Read only by the seed script, which
# runs on your machine — the Worker never sees them. Leave unset and the seed
# generates strong ones and prints them once.
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=

# --- Worker public configuration (wrangler.toml [vars]) --------------------
# Committed in apps/edge/wrangler.toml because none of it is a credential.
# Listed here so the full set is documented in one place.
#   ENVIRONMENT             demo | staging | preview | development
#   DEMO_MODE               "true" — disables real payment and email. Never
#                           weakens authentication or authorisation.
#   ALLOWED_ORIGINS         comma-separated exact origins permitted to send
#                           credentialed requests. Never "*".
#   PUBLIC_MEDIA_BASE_URL   optional CDN base for R2 objects; empty means the
#                           Worker serves them itself.

# --- Pages build variables -------------------------------------------------
# Set in the Cloudflare Pages project, not here. API_BASE_URL is the deployed
# Worker's URL; the build bakes it into the client bundle, so it must be a
# public URL and must contain no credential.
# API_BASE_URL=https://outlet-demo-api.<your-subdomain>.workers.dev

# --- Never put these in any file ------------------------------------------
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID belong in your shell or in
# GitHub Secrets. A Cloudflare API token can create and delete infrastructure;
# it is the one credential in this project whose leak is not recoverable by
# rotating a password.
